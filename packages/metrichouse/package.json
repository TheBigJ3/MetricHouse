{
  "name": "metrichouse",
  "version": "0.2.0",
  "description": "Lightweight metric collection for TypeScript that fits the stack you already have: it buckets, aggregates and hands you rows to store anywhere.",
  "license": "MIT",
  "author": "TheBigJ3",
  "homepage": "https://github.com/TheBigJ3/MetricHouse#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheBigJ3/MetricHouse.git",
    "directory": "packages/metrichouse"
  },
  "bugs": {
    "url": "https://github.com/TheBigJ3/MetricHouse/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.mts",
        "default": "./dist/core.mjs"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./memory": {
      "import": {
        "types": "./dist/memory.d.mts",
        "default": "./dist/memory.mjs"
      },
      "require": {
        "types": "./dist/memory.d.cts",
        "default": "./dist/memory.cjs"
      }
    },
    "./ioredis": {
      "import": {
        "types": "./dist/ioredis.d.mts",
        "default": "./dist/ioredis.mjs"
      },
      "require": {
        "types": "./dist/ioredis.d.cts",
        "default": "./dist/ioredis.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint:publish": "publint --strict && attw --pack . --profile node16"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@types/node": "catalog:",
    "ioredis": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "metrics",
    "counter",
    "clickhouse",
    "redis",
    "analytics",
    "telemetry"
  ],
  "peerDependencies": {
    "ioredis": ">=5"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  }
}
